@startuml datatypes
!include style.iuml
title TrendDetective (main @ a6e430f) — Data contracts between the work areas
hide empty methods
hide circle
skinparam nodesep 40
skinparam ranksep 50

package "① Map widget" as D1 #e3eefc;line:2f6fb3 {
  class "AreaFeature" <<GeoJSON Feature, ① → ②>> {
    {field} geometry: Polygon (CCW ring) or Point, [lng, lat] WGS84
    {field} bbox: [west, south, east, north]
    {field} properties.selectionId: string
    {field} properties.shape: rectangle | polygon | freehand | point
    {field} properties.crossesAntimeridian: boolean
    {field} properties.areaKm2: number (0 for a point)
  }
  class "MapData" <<TS union, consumed by ①>> {
    {field} geojson: {type, id?, data: FeatureCollection, outline?, fillOpacity?}
    {field} raster: {type, tiles: string[], bounds?, ...}
    {field} image: {type, url, bounds}
    {field} feature.properties.color: CSS colour (optional)
  }
}

package "② UI & web server" as D2 #e2f3e6;line:2e8b57 {
  class "Apply body" <<JSON  POST /api/buttons/apply>> {
    {field} topics: {name: bool}
    {field} tools: {name: bool}
    {field} timeintervall: ["DD.MM.YYYY", "DD.MM.YYYY"]
    {field} interval_length: [float > 0, "Day" | "Month" | "Year"]
    {field} area: AreaFeature | null
  }
  class "UserRequest" <<Python dataclass>> {
    {field} topics: dict[str, bool]
    {field} tools: dict[str, bool]
    {field} timeintervall: tuple[date, date]
    {field} interval_length: tuple[float, str]
    {field} area: dict | None
  }
  class "visualization" <<JSON, ③ → ②>> {
    {field} topics.<name>.labels: str[] DD.MM.YYYY (G9 not drawn)
    {field} topics.<name>.values: number[] (one per interval)
    {field} topics.<name>.mean: number | null
    {field} topics.<name>.coordinates: [lat, lon] (area centre)
    {field} topics.<name>.station: {id, name, latitude, longitude, elevation, distance_km} | null
    {field} topics.<name>.error: str (only if the topic failed)
    {field} topics.<name>.tools["Linear Regression"]: {slope, intercept, trend_line, observations}
    {field} topics.<name>.tools["t-Test"]: {available, t_statistic, p_value, significant}
    {field} topics.<name>.tools["Mann-Kendall"]: {trend, p_value, tau, ...} (G7 not drawn)
    {field} map_layers[0] "user-request-results": one feature per topic, colour = slope sign
    {field} map_layers[1] "measuring-stations": Point per station
  }
}

package "④ API wrapper" as D4 #eee6fb;line:7048b8 {
  class "PointDataRequest" <<Python frozen dataclass>> {
    {field} latitude: float (-90..90)
    {field} longitude: float (-180..180)
    {field} topic: str (key of noaa_api.TOPICS)
    {field} start_date: date
    {field} end_date: date (≥ start_date)
  }
  class "Observation record" <<dict yielded by an Iterator>> {
    {field} date: str "YYYY-MM-DD" daily · "YYYY-MM" monthly (G3) · "YYYY" annual (G3)
    {field} station / name: str
    {field} longitude / latitude / elevation: float
    {field} value: float | int | str
    {field} description: str (NCEI code, e.g. "tmax")
    {field} no unit field (metric implied) (G9)
  }
}

package "③ Data & calculations" as D3 #fdeedd;line:c46a12 {
  class "Series input" <<list | tuple | Tensor>> {
    {field} time: 1-D numbers (e.g. days since start), unique
    {field} values: 1-D finite numbers, same length, n ≥ 3
  }
  class "TrendAnalysis" <<frozen dataclass>> {
    {field} slope, intercept, r_value: float
    {field} t_statistic, p_value, standard_error: float
    {field} confidence_interval: (low, high)
    {field} observations: int
  }
  class "MannKendallResult" <<frozen dataclass>> {
    {field} s_statistic: int
    {field} z_statistic, p_value, tau, variance: float
    {field} trend: "increasing" | "decreasing" | "no significant trend"
  }
}

"AreaFeature" -[#2f6fb3,bold]-> "Apply body" : <color:#2f6fb3>① → ② onAreaSelected</color>
"Apply body" --> "UserRequest" : set_request_inputs + on_apply\n(parse_dd_mm_yyyy)
"PointDataRequest" --> "Observation record" : fetch_point_data()\n→ list[Iterator[record]], one per variable
"Series input" --> "TrendAnalysis" : LinearRegression.analyze_trend()
"Series input" --> "MannKendallResult" : mann_kendall_test()

"UserRequest" -[#2f6fb3,bold]-> "PointDataRequest" : <color:#2f6fb3>③ builds one per topic,</color>\n<color:#2f6fb3>area → centre point (G1)</color>
"Observation record" -[#2f6fb3,bold]-> "Series input" : <color:#2f6fb3>_bin_records(): mean per interval,</color>\n<color:#2f6fb3>all variables merged (G5)</color>
"Series input" -[#2f6fb3,bold]-> "visualization" : <color:#2f6fb3>process_user_request()</color>
"MannKendallResult" -[#2f6fb3,bold]-> "visualization" : <color:#2f6fb3>tools["Mann-Kendall"]</color>
"TrendAnalysis" .[#b03a2e,dashed].> "visualization" : <color:#b03a2e>G8 never used</color>
"visualization" -[#2f6fb3,bold]-> "MapData" : <color:#2f6fb3>② → ① map_layers</color>
@enduml
