@startuml sequence
!include style.iuml
title TrendDetective (main @ b040fc3) — Sequence across the four work areas
autonumber

actor User
box "① Map widget" #e3eefc
  participant "embed.tsx\nMapController" as EMB
  participant "MapWidget +\nSelectionManager" as SM
end box
box "② UI & web server" #e2f3e6
  participant "index.html\nscript" as JS
  participant "app.py\nWebAppHandler" as H
  participant "interface.py\nAppInterface" as AI
end box
box "③ Data & calculations" #fdeedd
  participant "src/task.py" as T
end box
box "④ API wrapper" #eee6fb
  participant "api_wrapper" as AW
  participant "NOAAClient" as NC
end box

== Server start ==
H -> AI : import interface
AI -[#b03a2e]> T : <color:#b03a2e>✖ from src.task import get_available_tools, process_user_request</color>
T --[#b03a2e]> AI : <color:#b03a2e>ImportError → server exits. Steps below assume it is fixed.</color>

== Page load ==
JS -[#2f6fb3]> EMB : <color:#2f6fb3>② → ①</color> mount(el, {onAreaSelected, onAreaCleared})
JS -> H : GET /api/topics
H -> AI : get_sorted_topics()
AI -[#2f6fb3]> AW : <color:#2f6fb3>② → ④</color> get_all_topics_list()
AW --> AI : list[str] (NOAA TOPICS keys)
H --> JS : {topics: list[str]}
JS -> H : GET /api/tools
H -> AI : get_sorted_tools()
AI -[#b03a2e]> T : <color:#b03a2e>✖ get_available_tools() → list[str]</color>
H --> JS : {tools: list[str]}

== Selection ==
User -> SM : draw area or pick point
SM -[#2f6fb3]-> JS : <color:#2f6fb3>① → ②</color> onAreaSelected(AreaFeature)

== Apply ==
User -> JS : topics, tools, DD.MM.YYYY dates, interval; click Apply
JS -> EMB : setLoading(true)
JS -> H : POST /api/buttons/apply\n{topics, tools, timeintervall: [str,str], interval_length, area}
H -> AI : set_request_inputs() → parse_dd_mm_yyyy()
H -> AI : trigger_button("apply") → on_apply()
AI -> AI : UserRequest(topics, tools, timeintervall: (date, date), ...)
AI -[#b03a2e]> T : <color:#b03a2e>✖ process_user_request(UserRequest)</color>
group #fff6f0 missing inside process_user_request
  T -[#b03a2e,dashed]> AW : <color:#b03a2e>③ ⇢ ④ PointDataRequest per topic and location</color>
  AW -> NC : fetch_point_data()
  NC --> AW : list[Iterator[dict]], one per variable
  AW --[#b03a2e,dashed]> T : <color:#b03a2e>④ ⇢ ③ records → (time, values) per interval</color>
  T -> T : LinearRegression.analyze_trend() → TrendAnalysis\nmann_kendall_test() → MannKendallResult
  T --[#b03a2e,dashed]> AI : <color:#b03a2e>③ ⇢ ② {topics: {...}, map_layers: [...]}</color>
end
AI -> AI : last_task_results = result
H --> JS : 204
JS -> H : GET /api/user-request
H --> JS : {user_request, visualization: last_task_results}
JS -> JS : renderVisualization(): badges + SVG chart per topic
JS -[#b03a2e,dashed]> EMB : <color:#b03a2e>② ⇢ ① setResultData(visualization.map_layers)</color>
JS -> EMB : setLoading(false)
@enduml
