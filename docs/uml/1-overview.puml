  database "**UserRequest** + last_task_results" as UR #ffffff;line:2e8b57
}

package "③ DATA MANIPULATION & CALCULATIONS\nsrc/task.py · src/test_task.py" as P3 #fdeedd;line:c46a12;line.bold {
  component "**LinearRegression**\nanalyze_trend(time, values) → TrendAnalysis\n(OLS slope, t-test, confidence interval)\ntrain(X, y) → (w, b)" as LR #ffffff;line:c46a12
