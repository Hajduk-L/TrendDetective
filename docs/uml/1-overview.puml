@startuml overview
!include style.iuml
title TrendDetective (main @ c3d7550) — Four work areas and how they connect
skinparam componentStyle rectangle
skinparam nodesep 60
skinparam ranksep 70

actor User

package "① MAP WIDGET\nmap-widget/  →  static/map-widget/" as P1 #e3eefc;line:2f6fb3;line.bold {
  component "**embed.tsx**  window.TrendDetectiveMap\nmount(el, options) → MapController\nsetResultData · setLoading · getArea\nclearArea · fitToArea · destroy" as T1API #ffffff;line:2f6fb3
  component "**MapWidget** (React)\nprops: onAreaSelected · resultData · loading" as MWc #ffffff;line:2f6fb3
  component "**SelectionManager**\nsetTool · getArea · setArea · clear" as SM #ffffff;line:2f6fb3
  component "**DataRenderer**\nsetData(MapData[])" as DR #ffffff;line:2f6fb3
  component "**MapEngine**\nMapLibre map · setStyle\nsetProjection · fitToBBox" as ME #ffffff;line:2f6fb3
  component "**geo.ts**\nnormalizeRing · geodesicAreaKm2\nwrapLng · splitAtAntimeridian" as GEO #ffffff;line:2f6fb3
}

package "② USER INTERFACE & WEB SERVER\nindex.html · app.py · interface.py" as P2 #e2f3e6;line:2e8b57;line.bold {
  component "**index.html form**\ndates · interval · topic dropdown" as Form #ffffff;line:2e8b57
  component "**index.html script**\nloadTopics · renderTopics\ntriggerButton · formatArea" as JS #ffffff;line:2e8b57
  component "**app.py  WebAppHandler**\nGET /api/topics · /api/buttons · /api/user-request\nPOST /api/buttons/<id>" as H #ffffff;line:2e8b57
  component "**interface.AppInterface**\nget_sorted_topics · set_request_inputs\ntrigger_button · on_apply" as AI #ffffff;line:2e8b57
  component "**interface.marten**\ngetTopics() — placeholder list" as M #ffffff;line:2e8b57
  database "**UserRequest**\nlast_user_request" as UR #ffffff;line:2e8b57
}

package "④ API WRAPPER\napi_wrapper.py · noaa_api.py · noaa_test.py" as P4 #eee6fb;line:7048b8;line.bold {
  component "**api_wrapper**\nfetch_data_single_topic_single_coordinate()\nget_all_topics_list() · _PROVIDERS" as AW #ffffff;line:7048b8
  component "**NOAAClient**\nfetch_point_data · _select_nearest_station\n_normalize_observations · _iter_measurements" as NC #ffffff;line:7048b8
  component "**noaa_test.py**\nrun_noaa_test() — manual check" as CLI #ffffff;line:7048b8
  database "**data/noaa_test/*.json**\nnested JSON: one list per variable" as F #ffffff;line:7048b8
}
cloud "NOAA NCEI\nsearch/v1 · data/v1" as NCEI

package "③ DATA MANIPULATION & CALCULATIONS\nsrc/task.py" as P3 #fdeedd;line:c46a12;line.bold {
  component "**Task** (abstract)\nprocess(X, y)" as T #ffffff;line:c46a12
  component "**LinearRegression**\nprocess → (w, b)\ntorch.linalg.lstsq" as LR #ffffff;line:c46a12
}

' ---------- inside ① ----------
T1API --> MWc : props
MWc --> ME : creates
MWc --> SM : creates
MWc --> DR : creates
SM --> GEO : ring → bbox, km²
DR --> ME : adds sources / layers

' ---------- inside ② ----------
User --> Form : input
Form --> JS : str · float · bool
JS --> H : HTTP + JSON
H --> AI : set_request_inputs()\ntrigger_button()
AI --> M : getTopics()\n→ list[str]
AI --> UR : on_apply()
UR --> H : to_dict()

' ---------- inside ④ ----------
CLI --> AW : PointDataRequest
AW --> NC : PointDataRequest
NC --> NCEI : HTTPS GET
NCEI --> NC : raw JSON rows
NC --> F : list[list[dict]]
F --> NC : streamed with ijson
AW --> CLI : list[Iterator[dict]]\none per variable (tmax, tmin, ...)

' ---------- inside ③ ----------
T <|-- LR

' ---------- between areas: working today ----------
User --> MWc : draws area
JS -[#2f6fb3,bold]-> T1API : <color:#2f6fb3>**② → ①  mount(el, {onAreaSelected, onAreaCleared})**</color>
T1API -[#2f6fb3,bold]-> JS : <color:#2f6fb3>**① → ②  onAreaSelected(AreaFeature)**</color>\n<color:#2f6fb3>GeoJSON Polygon + bbox + properties</color>

' ---------- between areas: missing (dashed) ----------
M .[#b03a2e,dashed].> AW : <color:#b03a2e>② ⇢ ④  get_all_topics_list(): list[str]</color>\n<color:#b03a2e>exists, not called</color>
UR .[#b03a2e,dashed].> AW : <color:#b03a2e>② ⇢ ④  UserRequest → PointDataRequest(s)</color>\n<color:#b03a2e>no converter yet</color>
F .[#b03a2e,dashed].> T : <color:#b03a2e>④ ⇢ ③  Iterator[dict] per variable → Tensor X, y</color>\n<color:#b03a2e>no loader yet</color>
LR .[#b03a2e,dashed].> H : <color:#b03a2e>③ ⇢ ②  results (trend, w, b) → JSON</color>\n<color:#b03a2e>no route yet</color>
JS .[#b03a2e,dashed].> T1API : <color:#b03a2e>② ⇢ ①  setResultData(MapData)</color>\n<color:#b03a2e>API ready, never called</color>

P1 -[hidden]right- P2
P2 -[hidden]right- P4
P2 -[hidden]down- P3

legend right
  |= Area |= Owner |= Folder / files |
  |<back:#e3eefc> ① Map widget </back>| Dev 1 | map-widget/src/widget, embed.tsx |
  |<back:#e2f3e6> ② UI & web server </back>| Dev 2 | index.html, app.py, interface.py |
  |<back:#fdeedd> ③ Data & calculations </back>| Dev 3 | src/task.py |
  |<back:#eee6fb> ④ API wrapper </back>| Dev 4 | api_wrapper.py, noaa_api.py, noaa_test.py |
  | **──►** | | call or data flow inside one area |
  | <color:#2f6fb3>**━━►**</color> | | connection between areas that works today |
  | <color:#b03a2e>**┄┄►**</color> | | connection between areas still missing |
endlegend
caption On main, only ① ↔ ② are connected. The red dashed arrows are the interfaces the four areas still have to agree on.
@enduml
