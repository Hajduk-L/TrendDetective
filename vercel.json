{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "*.py",
          "src/**",
          "data/**",
          "vercel-data/**"
        ]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "explorer/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(explorer|globe)",
      "status": 301,
      "headers": {
        "Location": "/explorer/"
      }
    },
    {
      "src": "/explorer/",
      "dest": "/explorer/index.html"
    },
    {
      "src": "/explorer/(.*)",
      "dest": "/explorer/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "fluid": true
}
